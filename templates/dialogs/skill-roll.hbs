<div class="emblem-skill-roll-form">
  <h2 class="emblem-skill-roll-title">{{skillLabel}} Skill Check</h2>
  <div class="form-group">
    <label>Roll Type</label>
    <select name="mode">
      <option value="standard" selected>Standard Roll</option>
      <option value="advantage">Roll with Advantage</option>
      <option value="disadvantage">Roll with Disadvantage</option>
    </select>
  </div>
</div>
