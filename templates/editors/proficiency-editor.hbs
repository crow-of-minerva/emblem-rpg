<div class="ed-container">
  <div class="ed-section">
    <div class="ed-row"><label class="ed-label">Unit Rank</label><input type="number" name="value" value="{{profValue}}" min="0" step="1"></div>
    <div class="ed-row"><label class="ed-label">Class Rank</label><input type="text" value="{{profClass}}" disabled></div>
    <div class="ed-row"><label class="ed-label">Total Proficiency</label><input type="text" value="{{profTotal}}" disabled></div>
  </div>
  <div class="ed-section">
    <div class="ed-row"><label class="ed-label">Current XP</label><input type="number" name="xpValue" value="{{xpValue}}" min="0" step="1"></div>
    <div class="ed-row"><label class="ed-label">XP Until Increase</label><input type="text" value="{{neededXP}}" disabled></div>
  </div>
</div>
