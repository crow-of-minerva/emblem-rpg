<div class="ed-container">
  <div class="ed-section">
    <div class="ed-row"><label class="ed-label">Unit Rank</label><input type="number" name="value" value="{{value}}" min="0" step="1"></div>
    <div class="ed-row"><label class="ed-label">Class Rank</label><input type="text" value="{{classLabel}}" disabled></div>
    <div class="ed-row"><label class="ed-label">Total Rank</label><input type="text" value="{{totalLabel}}" disabled></div>
  </div>
  <div class="ed-section">
    <div class="ed-row"><label class="ed-label">Current XP</label><input type="number" name="xpValue" value="{{xp}}" min="0" step="1"></div>
    <div class="ed-row"><label class="ed-label">XP Until Increase</label><input type="text" value="{{xpMax}}" disabled></div>
  </div>
</div>
