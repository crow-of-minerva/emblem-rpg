<div class="effect-preview-dialog haggle-preview">
  <div class="effect-header">
    <div class="effect-confirmation-prompt">
      <img class="item-icon haggle-icon" src="{{iconImage}}" alt="Trading" />
      <span class="confirmation-text">Spend your Downtime Action to Haggle with {{vendorName}}?</span>
    </div>
  </div>
  <hr class="effect-preview-divider" />
  <div class="target-grid-container">
    <div class="target-grid single-target" data-target-count="1">
      <div class="target-token-container centered" data-target-index="0">
        <div class="target-token-frame">
          <img src="{{vendorImage}}" alt="{{vendorName}}" class="target-token-image" />
        </div>
        <label class="target-name">{{vendorName}}</label>
      </div>
    </div>
  </div>
</div>
