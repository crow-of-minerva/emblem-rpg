                <span class="eff-row-drag" data-tooltip="{{tooltip 'object.drag-effect'}}"><i class="fas fa-grip-vertical"></i></span>
                <span class="eff-row-pill eff-row-pill-{{entry.trigger}}">{{triggerLabel entry.trigger}}</span>
                <input type="text" class="eff-row-name" data-effect-index="{{idx}}" value="{{entry.name}}" placeholder="Effect name" />
                <span class="eff-row-summary" data-tooltip="{{entry.action.steps.length}} step(s)">{{entry.action.steps.length}} step{{#unless (eq entry.action.steps.length 1)}}s{{/unless}}</span>
                <button type="button" class="eff-row-btn eff-row-edit" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'sheet.edit'}}"><i class="fas fa-pen"></i></button>
                <button type="button" class="eff-row-btn eff-row-delete" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'sheet.delete'}}"><i class="fas fa-trash"></i></button>
              </div>
              {{/each}}
            </div>
          </div>

        </div>
      </section>

    </div>
  </section>
  {{/if}}

  
  {{#if featureBracketed}}
  <section class="obj-section obj-bracketed" data-tooltip="{{tooltip 'object.feature-unavailable'}}">
    <div class="obj-section-body">
      <div class="obj-empty">{{tooltip 'object.feature-unavailable'}}</div>
    </div>
  </section>
  {{/if}}

  {{!-- The Altar authoring fields, commented out while BRACKETED_OBJECT_TYPES (contracts/domains/objects.mjs)
  lists Altar as not built yet. The commented-out Altar code in ui/apps/sheets/object/sheet.mjs goes with them.
  {{#if (eq system.objectType "Altar")}}
  <section class="obj-section altar-body">
    <div class="obj-section-body">
      <div class="obj-fields">
        <label class="obj-field"><span>Deity</span>
          <input type="text" name="system.altar.deity" value="{{system.altar.deity}}" />
        </label>
        <label class="obj-field"><span>Religion</span>
          <input type="text" name="system.altar.religion" value="{{system.altar.religion}}" />
        </label>
        <label class="obj-field obj-field-sm"><span>Offering</span>
          <input type="number" name="system.altar.minOffering" value="{{system.altar.minOffering}}" min="0" step="1" />
        </label>
      </div>
      <div class="obj-fields altar-tiers">
        {{#each altarTiers}}
        <label class="obj-field obj-field-sm"><span>{{this.label}}</span>
          <input type="number" name="system.altar.tierMins.{{this.key}}" value="{{this.value}}" min="0" step="1" />
        </label>
        {{/each}}
      </div>
      <label class="obj-field obj-field-full"><span>Description</span>
        <textarea name="system.altar.description" rows="2">{{system.altar.description}}</textarea>
      </label>
    </div>
  </section>

  <section class="obj-section object-inventory altar-boons">
    <div class="obj-section-head">
      <span class="obj-section-title">Boons</span>
      <span class="obj-section-meta">{{system.altar.boons.length}} boon{{#unless (eq system.altar.boons.length 1)}}s{{/unless}}</span>
    </div>
    <div class="obj-section-body">
      {{#if system.altar.boons.length}}
      <div class="obj-list">
        {{#each system.altar.boons as |boon bidx|}}
        <div class="boon-item obj-row" data-boon-index="{{bidx}}">
          <img class="obj-row-img" src="{{boon.img}}" alt="{{boon.name}}" />
          <span class="obj-row-name">{{boon.name}}</span>
          <input type="hidden" name="system.altar.boons.{{bidx}}.uuid" value="{{boon.uuid}}" />
          <input type="hidden" name="system.altar.boons.{{bidx}}.name" value="{{boon.name}}" />
          <input type="hidden" name="system.altar.boons.{{bidx}}.img" value="{{boon.img}}" />
          <label class="obj-chip obj-chip-row"><span>Tier</span><input type="number" name="system.altar.boons.{{bidx}}.tier" value="{{boon.tier}}" min="1" max="5" step="1" /></label>
          <label class="obj-chip obj-chip-row"><span>%</span><input type="number" name="system.altar.boons.{{bidx}}.percent" value="{{boon.percent}}" min="0" max="100" step="1" /></label>
          <button type="button" class="boon-item-delete obj-row-x" data-boon-index="{{bidx}}" data-tooltip="{{tooltip 'object.remove-boon'}}"><i class="fas fa-times"></i></button>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="obj-empty">Drop Equipment, Consumables, Miscellaneous items, Spells or Abilities here.</div>
      {{/if}}
    </div>
  </section>
  {{/if}}
  --}}

  {{#if (eq system.objectType "Cooking Pot")}}
  <section class="obj-section cooking-body">
    <div class="obj-section-head">
      <span class="obj-section-title">Recipes</span>
      <span class="obj-section-meta">{{recipeLibrary.defaults}} default | {{recipeLibrary.personal}} personal</span>
    </div>
    <div class="obj-section-body">
      <div class="cooking-library-row">
        <span class="cooking-library-note">Every Cooking Pot offers the Recipe Library's Default recipes, plus any Personal recipes linked to the chef.</span>
        <button type="button" class="cooking-open-library obj-add-btn"><i class="fas fa-utensils"></i> Open Recipe Library</button>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if (eq system.objectType "Instrument")}}
  <section class="obj-section instrument-body">
    <div class="obj-section-head">
      <span class="obj-section-title">Songs</span>
      <span class="obj-section-meta">{{songLibrary.defaults}} default | {{songLibrary.personal}} personal</span>
    </div>
    <div class="obj-section-body">
      <div class="cooking-library-row instrument-library-row">
        <span class="cooking-library-note">Every Instrument offers the Song Library's Default songs, plus any Personal songs linked to the lead performer.</span>
        <button type="button" class="instrument-open-library obj-add-btn"><i class="fas fa-music"></i> Open Song Library</button>
      </div>
    </div>
  </section>
  {{/if}}

  {{#if (eq system.objectType "Stationary")}}
  <section class="obj-section stationary-body">
    <div class="obj-section-head">
      <span class="obj-section-title">Factions</span>
      <span class="obj-section-meta">{{stationaryFactions.length}} faction{{#unless (eq stationaryFactions.length 1)}}s{{/unless}}</span>
    </div>
    <div class="obj-section-body">
      <div class="stationary-note">Units may draft requisitions to these factions with Civics.</div>
      {{#if stationaryFactions.length}}
      <div class="obj-list stationary-faction-list">
        {{#each stationaryFactions as |row idx|}}
        <div class="stationary-faction obj-row{{#unless row.enabled}} is-disabled{{/unless}}{{#if row.requisitioned}} is-requisitioned{{/if}}" data-faction-id="{{row.id}}">
          <input type="hidden" name="system.requisition.factions.{{idx}}._id" value="{{row.id}}" />
          <input type="hidden" name="system.requisition.factions.{{idx}}.requisitioned" value="{{row.requisitioned}}" />
          <input type="text" class="stationary-faction-name" name="system.requisition.factions.{{idx}}.name" value="{{row.name}}" maxlength="{{@root.factionNameMax}}" placeholder="Faction name" data-tooltip="{{tooltip 'object.faction-name'}}" />
          <select class="stationary-faction-relation" name="system.requisition.factions.{{idx}}.relation" data-tooltip="{{tooltip 'object.faction-relation'}}">
            {{#each @root.factionRelations}}
            <option value="{{this.value}}" {{#if (eq this.value row.relation)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          <select class="stationary-faction-wealth" name="system.requisition.factions.{{idx}}.wealth" data-tooltip="{{tooltip 'object.faction-wealth'}}">
            {{#each @root.factionWealth}}
            <option value="{{this.value}}" {{#if (eq this.value row.wealth)}}selected{{/if}}>{{this.label}}</option>
            {{/each}}
          </select>
          <label class="stationary-faction-toggle{{#if row.enabled}} is-on{{/if}}" data-tooltip="{{tooltip 'object.faction-enabled'}}">
            <input type="checkbox" name="system.requisition.factions.{{idx}}.enabled" {{#if row.enabled}}checked{{/if}} />
            <i class="fas {{#if row.enabled}}fa-toggle-on{{else}}fa-toggle-off{{/if}}"></i>
          </label>
          <button type="button" class="stationary-faction-delete obj-row-x" data-action="deleteFaction" data-tooltip="{{tooltip 'object.remove-faction'}}"><i class="fas fa-times"></i></button>
          {{#if row.requisitioned}}
          <div class="stationary-faction-lock">
            <span class="stationary-lock-badge" data-tooltip="{{tooltip 'object.faction-requisitioned'}}"><i class="fas fa-lock"></i> Requisitioned</span>
            {{#if @root.isGM}}
            <button type="button" class="stationary-lock-clear" data-action="clearFactionLock" data-tooltip="{{tooltip 'object.clear-faction-lock'}}"><i class="fas fa-lock-open"></i> Clear</button>
            {{/if}}
          </div>
          {{/if}}
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="obj-empty">No factions yet.</div>
      {{/if}}
      <button type="button" class="stationary-add-faction obj-add-btn" data-action="addFaction" {{#if factionsFull}}disabled{{/if}}><i class="fas fa-plus"></i> Add faction</button>
    </div>
  </section>
  {{/if}}

  
  {{#if (eq system.objectType "Workshop")}}
  <section class="obj-section workshop-body">
    <div class="obj-section-body">
      <div class="obj-empty">Characters can interact with this Object to repair or refine equipment.</div>
    </div>
  </section>
  {{/if}}

  
  {{#if (eq system.objectType "Laboratory")}}
  <section class="obj-section laboratory-body">
    <div class="obj-section-body">
      <div class="obj-empty">Characters can interact with this Object to craft Consumables or repair Staves.</div>
    </div>
  </section>
  {{/if}}

  

  
  

  
  {{#if (eq system.objectType "Gathering Node")}}
  <section class="obj-section gather-body">
    <div class="obj-section-body">
      <div class="obj-fields">
        <label class="obj-field"><span>Skill</span>
          <select name="system.gathering.skill">
            <option value="Athletics" {{#if (eq system.gathering.skill "Athletics")}}selected{{/if}}>Athletics</option>
            <option value="Nature"    {{#if (eq system.gathering.skill "Nature")}}selected{{/if}}>Nature</option>
            <option value="Finesse"   {{#if (eq system.gathering.skill "Finesse")}}selected{{/if}}>Finesse</option>
          </select>
        </label>
        <label class="obj-field obj-field-sm" data-tooltip="{{tooltip 'object.gather-multiplier'}}"><span>Mult</span>
          <input type="number" name="system.gathering.multiplier" value="{{system.gathering.multiplier}}" min="0.1" max="2" step="0.1" />
        </label>
        <label class="obj-field"><span>Method</span>
          <select name="system.gathering.animType">
            <option value="harvesting" {{#if (eq system.gathering.animType "harvesting")}}selected{{/if}}>Harvesting</option>
            <option value="mining"     {{#if (eq system.gathering.animType "mining")}}selected{{/if}}>Mining</option>
            <option value="logging"    {{#if (eq system.gathering.animType "logging")}}selected{{/if}}>Logging</option>
            <option value="shoveling"  {{#if (eq system.gathering.animType "shoveling")}}selected{{/if}}>Shoveling</option>
            <option value="fishing"    {{#if (eq system.gathering.animType "fishing")}}selected{{/if}}>Fishing</option>
          </select>
        </label>
      </div>
      <label class="obj-field obj-field-full"><span>Description</span>
        <textarea name="system.gathering.description" rows="2" placeholder="Description">{{system.gathering.description}}</textarea>
      </label>
    </div>
  </section>

  <section class="obj-section object-inventory">
    <div class="obj-section-head">
      <span class="obj-section-title">Gatherables</span>
      <span class="obj-section-meta">{{system.gathering.items.length}} kind{{#unless (eq system.gathering.items.length 1)}}s{{/unless}}</span>
    </div>
    <div class="obj-section-body">
      {{#if system.gathering.items.length}}
      <div class="obj-list">
        {{#each system.gathering.items as |g gidx|}}
        <div class="gather-item obj-row {{#if g.hidden}}is-hidden{{/if}}" data-gather-index="{{gidx}}">
          <img class="obj-row-img" src="{{g.img}}" alt="{{g.name}}" />
          <span class="obj-row-name">{{g.name}}</span>
          <input type="hidden" name="system.gathering.items.{{gidx}}.uuid" value="{{g.uuid}}" />
          <input type="hidden" name="system.gathering.items.{{gidx}}.name" value="{{g.name}}" />
          <input type="hidden" name="system.gathering.items.{{gidx}}.img" value="{{g.img}}" />
          <label class="obj-chip obj-chip-row" data-tooltip="{{tooltip 'object.gather-total'}}"><span>Total</span><input type="number" name="system.gathering.items.{{gidx}}.total" value="{{g.total}}" min="0" step="1" /></label>
          <label class="obj-chip obj-chip-row" data-tooltip="{{tooltip 'object.gather-weight'}}"><span>Wt</span><input type="number" name="system.gathering.items.{{gidx}}.weight" value="{{g.weight}}" min="0.1" max="1" step="0.1" /></label>
          <label class="gather-hidden-toggle obj-eye" data-tooltip="{{tooltip 'object.gather-hidden'}}">
            <input type="checkbox" name="system.gathering.items.{{gidx}}.hidden" {{#if g.hidden}}checked{{/if}} />
            <i class="fas {{#if g.hidden}}fa-eye-slash{{else}}fa-eye{{/if}}"></i>
          </label>
          <button type="button" class="gather-item-delete obj-row-x" data-gather-index="{{gidx}}" data-tooltip="{{tooltip 'object.remove-gatherable'}}"><i class="fas fa-times"></i></button>
        </div>
        {{/each}}
      </div>
      {{else}}
      <div class="obj-empty">Drop Resource items here.</div>
      {{/if}}
    </div>
  </section>
  {{/if}}

  
  

</div>
