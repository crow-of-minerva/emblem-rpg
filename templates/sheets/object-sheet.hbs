<div class="emblem-rpg object-sheet obj-{{accentSlug}}">

  
  <header class="obj-header">
    <div class="obj-portrait" data-action="editImage" data-tooltip="{{tooltip 'sheet.edit-image'}}">
      <img src="{{profileImg}}" class="{{#if pixelArt}}is-pixel-art{{/if}}" alt="{{actor.name}}" />
    </div>
    <div class="obj-headinfo">
      <input class="obj-name" name="name" type="text" placeholder="Object Name" maxlength="40" value="{{actor.name}}" />

      <div class="obj-subtype-row">
        <label class="obj-type-label">Type</label>
        <select class="obj-subtype" name="system.objectType">
          <option value="" {{#if (eq system.objectType "")}}selected{{/if}}>--</option>
          <optgroup label="Map Structures">
            <option value="Destructible" {{#if (eq system.objectType "Destructible")}}selected{{/if}}>Destructible</option>
            <option value="Armament" {{#if (eq system.objectType "Armament")}}selected{{/if}}>Armament</option>
            <option value="Door"     {{#if (eq system.objectType "Door")}}selected{{/if}}>Door</option>
          </optgroup>
          <optgroup label="Lootables">
            <option value="Chest"    {{#if (eq system.objectType "Chest")}}selected{{/if}}>Chest</option>
            <option value="Loot"     {{#if (eq system.objectType "Loot")}}selected{{/if}}>Loot</option>
            <option value="Gathering Node" {{#if (eq system.objectType "Gathering Node")}}selected{{/if}}>Gathering Node</option>
          </optgroup>
          <optgroup label="Downtime Furnishings">
            <option value="Altar"       {{#if (eq system.objectType "Altar")}}selected{{/if}}>Altar</option>
            <option value="Cooking Pot" {{#if (eq system.objectType "Cooking Pot")}}selected{{/if}}>Cooking Pot</option>
            <option value="Stationary"  {{#if (eq system.objectType "Stationary")}}selected{{/if}}>Stationary</option>
            <option value="Workshop"    {{#if (eq system.objectType "Workshop")}}selected{{/if}}>Workshop</option>
            <option value="Laboratory"  {{#if (eq system.objectType "Laboratory")}}selected{{/if}}>Laboratory</option>
            <option value="Instrument"  {{#if (eq system.objectType "Instrument")}}selected{{/if}}>Instrument</option>
          </optgroup>
        </select>

        {{#if (eq system.objectType "Armament")}}
        <select class="obj-mini-select" name="system.armament.req" data-tooltip="{{tooltip 'object.proficiency'}}">
          <option value="None"      {{#if (eq system.armament.req "None")}}selected{{/if}}>None</option>
          <option value="Brawling"  {{#if (eq system.armament.req "Brawling")}}selected{{/if}}>Brawling</option>
          <option value="Blade"     {{#if (eq system.armament.req "Blade")}}selected{{/if}}>Blade</option>
          <option value="Polearm"   {{#if (eq system.armament.req "Polearm")}}selected{{/if}}>Polearm</option>
          <option value="Heavy"     {{#if (eq system.armament.req "Heavy")}}selected{{/if}}>Heavy</option>
          <option value="Bow"       {{#if (eq system.armament.req "Bow")}}selected{{/if}}>Bow</option>
          <option value="Covert"    {{#if (eq system.armament.req "Covert")}}selected{{/if}}>Covert</option>
          <option value="Arcane"    {{#if (eq system.armament.req "Arcane")}}selected{{/if}}>Arcane</option>
          <option value="Elemental" {{#if (eq system.armament.req "Elemental")}}selected{{/if}}>Elemental</option>
          <option value="Divine"    {{#if (eq system.armament.req "Divine")}}selected{{/if}}>Divine</option>
          <option value="Occult"    {{#if (eq system.armament.req "Occult")}}selected{{/if}}>Occult</option>
        </select>
        <select class="obj-mini-select obj-mini-rank" name="system.armament.rank" data-tooltip="{{tooltip 'object.rank'}}">
          <option value="0" {{#if (eq system.armament.rank 0)}}selected{{/if}}>--</option>
          <option value="1" {{#if (eq system.armament.rank 1)}}selected{{/if}}>E</option>
          <option value="2" {{#if (eq system.armament.rank 2)}}selected{{/if}}>D</option>
          <option value="3" {{#if (eq system.armament.rank 3)}}selected{{/if}}>C</option>
          <option value="4" {{#if (eq system.armament.rank 4)}}selected{{/if}}>B</option>
          <option value="5" {{#if (eq system.armament.rank 5)}}selected{{/if}}>A</option>
          <option value="6" {{#if (eq system.armament.rank 6)}}selected{{/if}}>S</option>
        </select>
        {{/if}}
      </div>

      <div class="obj-token-row">
        {{#if tokenLink.shown}}
        <label class="obj-token-grp obj-token-link" data-tooltip="{{tooltip 'object.token-link'}}">
          <span>Link</span>
          <input type="checkbox" class="object-token-link" {{#if tokenLink.linked}}checked{{/if}} {{#unless isEditable}}disabled{{/unless}} />
        </label>
        {{/if}}
        <span class="obj-token-grp" data-tooltip="{{tooltip 'object.token-size'}}">
          <i class="fas fa-up-right-and-down-left-from-center"></i>
          <input type="number" class="object-token-param" data-param="width" value="{{tokenParams.width}}" min="0.5" step="0.5" />
          <span class="obj-token-x">×</span>
          <input type="number" class="object-token-param" data-param="height" value="{{tokenParams.height}}" min="0.5" step="0.5" />
        </span>
        {{#unless perStateScale}}
        <span class="obj-token-grp" data-tooltip="{{tooltip 'object.image-scale'}}">
          <i class="fas fa-magnifying-glass-plus"></i>
          <input type="number" class="object-token-param" data-param="scale" value="{{tokenParams.scale}}" min="0.2" max="3" step="0.05" />
        </span>
        {{/unless}}
        <span class="obj-token-grp obj-token-tint-grp" data-tooltip="{{tooltip 'object.token-tint'}}">
          <i class="fas fa-droplet"></i>
          <input type="color" class="object-token-param obj-token-tint" data-param="tint" value="{{tokenParams.tint}}" />
        </span>
      </div>
    </div>
  </header>

  
  {{#if (eq system.objectType "Door")}}
  <section class="obj-section">
    <div class="obj-section-body obj-chest-top">
      <div class="obj-key-slot" data-drop-zone="key">
        {{#if keyItem}}
        <img class="obj-key-img" src="{{keyItem.img}}" alt="{{keyItem.name}}" />
        <span class="obj-key-name">{{keyItem.name}}</span>
        <button type="button" class="object-key-clear" data-tooltip="{{tooltip 'object.clear-key'}}"><i class="fas fa-times"></i></button>
        {{else}}
        <i class="fas fa-key obj-key-icon"></i>
        <span class="obj-key-placeholder">Drag the key item here</span>
        {{/if}}
      </div>
      <button type="button" class="object-lock-toggle {{#if system.locked}}is-locked{{/if}}" data-tooltip="{{#if system.locked}}Closed: blocks movement{{else}}Open: passable{{/if}}">
        <i class="fas {{#if system.locked}}fa-door-closed{{else}}fa-door-open{{/if}}"></i>
      </button>
      <label class="obj-field obj-field-inline">
        <span>DC</span>
        <input type="number" name="system.difficultyClass" value="{{system.difficultyClass}}" min="0" />
      </label>
    </div>
  </section>
  {{/if}}

  {{#if (eq system.objectType "Chest")}}
  <section class="obj-section">
    <div class="obj-section-body obj-chest-top">
      <div class="obj-key-slot" data-drop-zone="key">
        {{#if keyItem}}
        <img class="obj-key-img" src="{{keyItem.img}}" alt="{{keyItem.name}}" />
        <span class="obj-key-name">{{keyItem.name}}</span>
        <button type="button" class="object-key-clear" data-tooltip="{{tooltip 'object.clear-key'}}"><i class="fas fa-times"></i></button>
        {{else}}
        <i class="fas fa-key obj-key-icon"></i>
        <span class="obj-key-placeholder">Drag the key item here</span>
        {{/if}}
      </div>
      <button type="button" class="object-lock-toggle {{#if system.locked}}is-locked{{/if}}" data-tooltip="{{#if system.locked}}Locked{{else}}Unlocked{{/if}}">
        <i class="fas {{#if system.locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
      </button>
      <label class="obj-field obj-field-inline">
        <span>DC</span>
        <input type="number" name="system.difficultyClass" value="{{system.difficultyClass}}" min="0" />
      </label>
    </div>
  </section>
  {{/if}}

  
  {{#if artStateRows}}
  <section class="obj-section">
    <div class="obj-section-body">
      {{#each artStateRows}}
      <div class="obj-src-grid">
        <span class="obj-src-label obj-src-label-main">{{this.label}}</span>
        <span class="obj-src-label">scale</span>
        <span class="obj-src-label">tint</span>
        <span class="obj-src-label">x</span>
        <span class="obj-src-label">y</span>
        <span class="obj-src-label"></span>
        <input type="text" class="obj-src-input" data-src-target="{{this.key}}" value="{{this.src}}" readonly placeholder="{{this.placeholder}}" data-tooltip="{{tooltip 'object.pick-state-image'}}" />
        <input type="number" class="obj-src-scale" name="system.art.{{this.key}}.scale" value="{{this.scale}}" min="0.2" max="3" step="0.05" data-tooltip="{{tooltip 'object.state-scale'}}" />
        <input type="color" class="obj-src-tint" data-tint-target="{{this.key}}" value="{{this.tint}}" data-tooltip="{{tooltip 'object.state-tint'}}" />
        <input type="number" name="system.art.{{this.key}}.offsetX" value="{{this.offsetX}}" step="1" data-tooltip="{{tooltip 'object.state-offset-x'}}" />
        <input type="number" name="system.art.{{this.key}}.offsetY" value="{{this.offsetY}}" step="1" data-tooltip="{{tooltip 'object.state-offset-y'}}" />
        <div class="obj-src-cut-cell">
          {{#if ../isGM}}
          <button type="button" class="obj-src-cut-btn obj-btn" data-cut-target="{{this.key}}"><i class="fas fa-scissors"></i> Cut From Scene</button>
          {{/if}}
        </div>
      </div>
      {{/each}}

    </div>
  </section>
  {{/if}}

  
