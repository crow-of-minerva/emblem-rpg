<form class="emblem-rpg item-sheet" autocomplete="off" style="{{#if typeFlags.isCoinpurse}}height: 105px!important; max-height: 105px!important;{{/if}}">


  <section class="item-header">


    <div class="item-image">
      <img src="{{profileImg}}" class="{{#if pixelArt}}is-pixel-art{{/if}}" data-action="editImage" data-edit="img"
        data-tooltip="{{item.name}}" />
    </div>


    <div class="item-details">
      <input class="item-name" name="name" type="text" value="{{item.name}}" placeholder="Item Name" />
      <div class="item-type-row">
        <label class="item-type">{{item.type}}</label>
        <select class="item-subType" name="system.itemType">
          {{#if typeFlags.isEquipment}}
            <option value="Weapon" {{#if typeFlags.isWeapon}}selected{{/if}}>Weapon</option>
            <option value="Armor" {{#if typeFlags.isArmor}}selected{{/if}}>Armor</option>
            <option value="Staff" {{#if typeFlags.isStaff}}selected{{/if}}>Staff</option>
            <option value="Staff (U)" {{#if typeFlags.isStaffUtility}}selected{{/if}}>Staff (U)</option>
            <option value="Shield" {{#if typeFlags.isShield}}selected{{/if}}>Shield</option>
            <option value="Accessory" {{#if typeFlags.isAccessory}}selected{{/if}}>Accessory</option>
          {{else if typeFlags.isAbility}}
            <option value="Active" {{#if typeFlags.isActive}}selected{{/if}}>Active</option>
            <option value="Passive" {{#if typeFlags.isPassive}}selected{{/if}}>Passive</option>
            <option value="Weapon Art" {{#if typeFlags.isWeaponArt}}selected{{/if}}>Weapon Art</option>
            <option value="Mount" {{#if typeFlags.isMount}}selected{{/if}}>Mount</option>
          {{else if typeFlags.isSpell}}
            <option value="Attack" {{#if typeFlags.isAttack}}selected{{/if}}>Attack</option>
            <option value="Utility" {{#if typeFlags.isUtility}}selected{{/if}}>Utility</option>
          {{else if typeFlags.isConsumable}}
            <option value="Potion" {{#if typeFlags.isPotion}}selected{{/if}}>Potion</option>
            <option value="Bomb" {{#if typeFlags.isBomb}}selected{{/if}}>Bomb</option>
            <option value="Booster" {{#if typeFlags.isBooster}}selected{{/if}}>Booster</option>
            <option value="Promotion" {{#if typeFlags.isPromotion}}selected{{/if}}>Promotion</option>
          {{else if typeFlags.isMiscellaneous}}
            <option value="Coinpurse" {{#if typeFlags.isCoinpurse}}selected{{/if}}>Coinpurse</option>
            <option value="Other" {{#if typeFlags.isOther}}selected{{/if}}>Other</option>
          {{/if}}
        </select>

        {{#if typeFlags.isWeaponArt}}
        <div class="weapon-art-proficiencies">

          <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-brawling.png"
               data-action="toggleWeaponArtProficiency"
               data-proficiency="brawling"
               data-tooltip="{{tooltip 'type.brawling'}}"
               style="opacity: {{#if item.system.wepArtData.brawling}}1{{else}}0.2{{/if}};" />


          <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-blade.png"
               data-action="toggleWeaponArtProficiency"
               data-proficiency="blade"
               data-tooltip="{{tooltip 'type.blade'}}"
               style="opacity: {{#if item.system.wepArtData.blade}}1{{else}}0.2{{/if}};" />


          <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-polearm.png"
               data-action="toggleWeaponArtProficiency"
               data-proficiency="polearm"
               data-tooltip="{{tooltip 'type.polearm'}}"
               style="opacity: {{#if item.system.wepArtData.polearm}}1{{else}}0.2{{/if}};" />


          <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-heavy.png"
               data-action="toggleWeaponArtProficiency"
               data-proficiency="heavy"
               data-tooltip="{{tooltip 'type.heavy'}}"
               style="opacity: {{#if item.system.wepArtData.heavy}}1{{else}}0.2{{/if}};" />


          <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-bow.png"
               data-action="toggleWeaponArtProficiency"
               data-proficiency="bow"
               data-tooltip="{{tooltip 'type.bow'}}"
               style="opacity: {{#if item.system.wepArtData.bow}}1{{else}}0.2{{/if}};" />


          <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-covert.png"
               data-action="toggleWeaponArtProficiency"
               data-proficiency="covert"
               data-tooltip="{{tooltip 'type.covert'}}"
               style="opacity: {{#if item.system.wepArtData.covert}}1{{else}}0.2{{/if}};" />
        </div>
        {{/if}}

        {{#if typeFlags.showProficiencySelect}}
        <label class="proficiency-label" for="proficiency-select">Proficiency:</label>
        <select class="proficiency-select"
            name="{{#if typeFlags.isArmorOrShield}}system.armor.req{{else}}system.weapon.req{{/if}}"
            id="proficiency-select">
          {{#if typeFlags.isWeapon}}
            <option value="Brawling" {{#if (eq item.system.weapon.req "Brawling")}}selected{{/if}}>Brawling</option>
            <option value="Blade" {{#if (eq item.system.weapon.req "Blade")}}selected{{/if}}>Blade</option>
            <option value="Polearm" {{#if (eq item.system.weapon.req "Polearm")}}selected{{/if}}>Polearm</option>
            <option value="Heavy" {{#if (eq item.system.weapon.req "Heavy")}}selected{{/if}}>Heavy</option>
            <option value="Bow" {{#if (eq item.system.weapon.req "Bow")}}selected{{/if}}>Bow</option>
            <option value="Covert" {{#if (eq item.system.weapon.req "Covert")}}selected{{/if}}>Covert</option>
          {{else if typeFlags.isMagicalProficiency}}
            <option value="Arcane" {{#if (eq item.system.weapon.req "Arcane")}}selected{{/if}}>Arcane</option>
            <option value="Elemental" {{#if (eq item.system.weapon.req "Elemental")}}selected{{/if}}>Elemental</option>
            <option value="Divine" {{#if (eq item.system.weapon.req "Divine")}}selected{{/if}}>Divine</option>
            <option value="Occult" {{#if (eq item.system.weapon.req "Occult")}}selected{{/if}}>Occult</option>
          {{else if typeFlags.isArmorOrShield}}
            <option value="None" {{#if (eq item.system.armor.req "None")}}selected{{/if}}>None</option>
            <option value="Light" {{#if (eq item.system.armor.req "Light")}}selected{{/if}}>Light</option>
            <option value="Medium" {{#if (eq item.system.armor.req "Medium")}}selected{{/if}}>Medium</option>
            <option value="Heavy" {{#if (eq item.system.armor.req "Heavy")}}selected{{/if}}>Heavy</option>
          {{/if}}
        </select>
        {{#if typeFlags.showRankSelect}}
        <select class="proficiency-select-rank" name="system.weapon.rank" id="proficiency-select-rank">
          <option value="0" {{#if (eq item.system.weapon.rank 0)}}selected{{/if}}>--</option>
          <option value="1" {{#if (eq item.system.weapon.rank 1)}}selected{{/if}}>E</option>
          <option value="2" {{#if (eq item.system.weapon.rank 2)}}selected{{/if}}>D</option>
          <option value="3" {{#if (eq item.system.weapon.rank 3)}}selected{{/if}}>C</option>
          <option value="4" {{#if (eq item.system.weapon.rank 4)}}selected{{/if}}>B</option>
          <option value="5" {{#if (eq item.system.weapon.rank 5)}}selected{{/if}}>A</option>
          <option value="6" {{#if (eq item.system.weapon.rank 6)}}selected{{/if}}>S</option>
        </select>
        {{/if}}
        {{/if}}
      </div>
    </div>

  </section>


  <section class="item-left-divider" style="{{#if typeFlags.isCoinpurse}}display: none;{{/if}}">
    {{#if typeFlags.showUsesTracker}}

    <div class="usage-tracker">
      {{!-- _wireFormulaEditors in ui/apps/sheets/item/sheet.mjs makes the Uses label open the scaling editor. --}}
      <label class="uses-label-trigger" data-tooltip="{{tooltip 'item.click-to-edit-uses-parameters'}}">
        {{#if typeFlags.isDurabilityItem}}
          Durability
        {{else}}
          Uses
        {{/if}}
      </label>


      {{#unless (eq item.system.uses.type "infinite")}}
      <div class="uses-row">
        <input class="uses-input" type="number" name="system.uses.current" value="{{item.system.uses.current}}" min="0" max="{{item.system.uses.max}}" />
        <span class="uses-separator">/</span>
        {{#if (eq item.system.uses.type "conditional")}}
          <span class="uses-max-display" data-tooltip="{{tooltip 'item.maximum-uses-scaled-edit-via-the-uses-label'}}">{{item.system.uses.max}}</span>
        {{else}}
          <input class="uses-input" type="number" name="system.uses.max" value="{{item.system.uses.max}}" min="1" />
        {{/if}}
      </div>
      {{/unless}}


      <div class="uses-type-group" data-tooltip="{{tooltip 'item.uses-type-edit-via-the-uses-label'}}">
        <select class="uses-type-select" disabled>
          <option value="limited" {{#if (eq item.system.uses.type "limited")}}selected{{/if}}>Limited</option>
          <option value="infinite" {{#if (eq item.system.uses.type "infinite")}}selected{{/if}}>Infinite</option>
          <option value="conditional" {{#if (eq item.system.uses.type "conditional")}}selected{{/if}}>Conditional</option>
        </select>
      </div>


      {{#unless (eq item.system.uses.type "infinite")}}
      <label class="refreshes-row" data-tooltip="{{tooltip 'item.if-checked-this-item-s-remaining-uses-will-refresh-at-the-st'}}">
        <span class="toggle-text">Refreshes</span>
        <input class="refreshes-checkbox" type="checkbox" name="system.refreshes" {{#if item.system.refreshes}}checked{{/if}} />
      </label>
      {{/unless}}

    </div>
    {{/if}}

    {{#if typeFlags.isWeaponArt}}

    <div class="weapon-art-cost">
      <label data-tooltip="{{tooltip 'item.the-weapon-durability-cost-of-this-ability'}}">
        Cost
      </label>
      <input type="number" name="system.wepArtData.cost" value="{{item.system.wepArtData.cost}}"
             min="0" />
    </div>
    {{/if}}

    {{#if typeFlags.showTargetGroup}}

    <div class="target-group"{{#if typeFlags.isPotion}} data-tooltip="{{tooltip 'item.potions-always-target-self'}}"{{else if typeFlags.isBooster}} data-tooltip="{{tooltip 'item.boosters-always-target-self'}}"{{/if}}>
     {{#if typeFlags.isPotion}}
     <label class="target-label" data-tooltip="{{tooltip 'item.potions-always-target-self'}}">Target</label>
      <select class="compact-select" disabled>
        <option value="Self" selected>Self</option>
      </select>
      <input type="hidden" name="system.effectData.targetType" value="Self" />
     {{else if typeFlags.isBooster}}
     <label class="target-label" data-tooltip="{{tooltip 'item.boosters-always-target-self'}}">Target</label>
      <select class="compact-select" disabled>
        <option value="Self" selected>Self</option>
      </select>
      <input type="hidden" name="system.effectData.targetType" value="Self" />
     {{else}}
     <label class="target-label-trigger" data-tooltip="{{tooltip 'item.click-to-edit-target-parameters'}}">Target</label>
      <select class="compact-select" name="system.effectData.targetType">
        <option value="Any" {{#if (eq item.system.effectData.targetType "Any")}}selected{{/if}}>Any</option>
        <option value="Self" {{#if (eq item.system.effectData.targetType "Self")}}selected{{/if}}>Self</option>
        <option value="Friendly" {{#if (eq item.system.effectData.targetType "Friendly")}}selected{{/if}}>Friendly</option>
        <option value="Hostile" {{#if (eq item.system.effectData.targetType "Hostile")}}selected{{/if}}>Hostile</option>
        <option value="Ground" {{#if (eq item.system.effectData.targetType "Ground")}}selected{{/if}}>Ground</option>
      </select>
      {{/if}}
      {{#unless (eq item.system.effectData.targetType "Self")}}
      <select class="compact-select-spaced" name="system.effectData.rngType">
        <option value="Single" {{#if (eq item.system.effectData.rngType "Single")}}selected{{/if}}>Single</option>
        <option value="Multiple" {{#if (eq item.system.effectData.rngType "Multiple")}}selected{{/if}}>Multiple</option>
        <option value="Line" {{#if (eq item.system.effectData.rngType "Line")}}selected{{/if}}>Line</option>
        <option value="Area" {{#if (eq item.system.effectData.rngType "Area")}}selected{{/if}}>Area</option>
        <option value="Cone" {{#if (eq item.system.effectData.rngType "Cone")}}selected{{/if}}>Cone</option>
        <option value="Location" {{#if (eq item.system.effectData.rngType "Location")}}selected{{/if}}>Location</option>
      </select>
       {{/unless}}
       {{#if (eq item.system.effectData.rngType "Multiple")}}
       <div class="targets-row">
         <label>Num</label>
         <input type="number" name="system.effectData.targets" value="{{item.system.effectData.targets}}"
                min="2" />
       </div>
       {{/if}}
    </div>


      {{#unless (eq item.system.effectData.targetType "Self")}}
      <div class="range-group">
        <label class="range-label-trigger" data-tooltip="{{tooltip 'item.click-to-edit-range-scaling'}}">Range</label>
        <input type="text" name="system.effectData.rng" value="{{item.system.effectData.rng}}"
                min="1" />
          {{#if (eq item.system.effectData.rngType "Location")}}
          <div class="radius-row">
            <label data-tooltip="{{tooltip 'item.effect-size-at-the-target-location'}}">Radius</label>
            <input type="number" name="system.effectData.locationRng" value="{{item.system.effectData.locationRng}}"
                    min="1" />
          </div>
          {{/if}}
      {{#unless (or (eq item.system.effectData.rngType "Line") (eq item.system.effectData.rngType "Cone") (and (eq item.system.effectData.rngType "Location") (not (gt item.system.effectData.locationRng 0))))}}
      <select class="compact-select-spaced" name="system.effectData.rngShape">
        <option value="Normal" {{#if (eq item.system.effectData.rngShape "Normal")}}selected{{/if}}>Cross</option>
        <option value="Square" {{#if (eq item.system.effectData.rngShape "Square")}}selected{{/if}}>Square</option>
      </select>
      {{/unless}}
      </div>
      {{/unless}}
    {{/if}}

    {{#if typeFlags.isWeaponLike}}

    <div class="damage-stat-selector">

      <label data-tooltip="{{tooltip 'item.attacks-receive-a-damage-bonus-from-this-stat'}}">Atk Stat</label>


      <select name="system.weapon.atkStat" class="atk-stat-select">
        <option value="Might" {{#if (eq item.system.weapon.atkStat "Might")}}selected{{/if}}>Might</option>
        <option value="Wit" {{#if (eq item.system.weapon.atkStat "Wit")}}selected{{/if}}>Wit</option>
        <option value="Hybrid" {{#if (eq item.system.weapon.atkStat "Hybrid")}}selected{{/if}}>Hybrid</option>
      </select>
    </div>
    {{/if}}

    {{#if typeFlags.showLineOfSight}}
    <div class="los-selector">

      <label data-tooltip="{{tooltip 'item.what-this-item-s-range-ignores-when-checking-line-of-sight'}}">Line of Sight</label>


      <select name="system.effectData.losRule" class="los-rule-select">
        <option value="normal" {{#if (eq item.system.effectData.losRule "normal")}}selected{{/if}}>Normal</option>
        <option value="ignoreHeight" {{#if (eq item.system.effectData.losRule "ignoreHeight")}}selected{{/if}}>Ignore Elev.</option>
        <option value="ignoreLoS" {{#if (eq item.system.effectData.losRule "ignoreLoS")}}selected{{/if}}>Ignore LoS</option>
      </select>
    </div>
    {{/if}}

    {{#if typeFlags.isWeapon}}
    <div class="twohanded-selector">
      <label>Hands</label>
      <select name="system.weapon.twoHanded">
        <option value="false" {{#unless item.system.weapon.twoHanded}}selected{{/unless}}>One-Handed</option>
        <option value="true" {{#if item.system.weapon.twoHanded}}selected{{/if}}>Two-Handed</option>
      </select>
    </div>
    {{/if}}
  </section>


  <section class="item-right-divider" style="{{#if typeFlags.isCoinpurse}}display: none;{{/if}}">

    <div class="tab-navigator">
      <button type="button" class="tab-button {{#if (eq activeTab "overview")}}active{{/if}}" data-tab="overview">Overview</button>
       {{#if typeFlags.showEffectsTab}}
      <button type="button" class="tab-button {{#if (eq activeTab "effects")}}active{{/if}}" data-tab="effects">Effects</button>
      {{/if}}
      {{#unless typeFlags.isBooster}}
      <button type="button" class="tab-button {{#if (eq activeTab "modifiers")}}active{{/if}}" data-tab="modifiers">Modifiers</button>
      {{/unless}}
      {{#if typeFlags.showRequirementsTab}}
      <button type="button" class="tab-button {{#if (eq activeTab "requirements")}}active{{/if}}" data-tab="requirements">Requirements</button>
      {{/if}}
    </div>


    <div class="tab-content">
      <div class="tab-pane {{#if (eq activeTab "overview")}}active{{/if}}" data-tab-content="overview"{{#unless (eq activeTab "overview")}} style="display: none;"{{/unless}}>
        {{!-- This contenteditable is not a form field. _wireDescription in ui/apps/sheets/item/sheet.mjs saves it
          on blur, and bold and italic come from the browser's own shortcuts. --}}
        <div class="item-description-editor" style="height: {{typeFlags.descriptionHeight}}px;">
          <div class="ide-content" contenteditable="{{#if isGM}}true{{else}}false{{/if}}" data-placeholder="Item description">{{{descriptionHtml}}}</div>
        </div>

        {{#if typeFlags.isWeaponLike}}
        <div class="stats-container">
            <div class="weapon-stats">

            <label>Stats</label>


            <div class="wep-stats-grid">

                <div class="stat-row">
                <label>Atk</label>
                <input type="text" name="system.weapon.atk" value="{{item.system.weapon.atk}}" />
                </div>

                <div class="stat-row">
                <label>Brk</label>
                <input type="number" name="system.weapon.brk" value="{{item.system.weapon.brk}}" />
                </div>

                <div class="stat-row">
                <label>Rng</label>
                <input type="text" name="system.weapon.rng" value="{{item.system.weapon.rng}}" />
                </div>


                <div class="stat-row">
                <label>Wgt</label>
                <input type="number" name="system.wgt" value="{{item.system.wgt}}" />
                </div>

                <div class="stat-row">
                <label>Acc</label>
                <input type="number" name="system.weapon.acc" value="{{item.system.weapon.acc}}" />
                </div>

                <div class="stat-row">
                <label>Crit</label>
                <input type="number" name="system.weapon.crit" value="{{item.system.weapon.crit}}" />
                </div>
            </div>
            </div>

            <div class="wep-damage-types">
            <label class="dmg-conditions-trigger" data-tooltip="{{tooltip 'item.click-to-edit-per-damage-type-conditions'}}">Damage Types</label>
            <div class="dmg-type-grid">
                <label class="type-toggle" data-tooltip="{{tooltip 'type.slashing'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/slashing.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.slashing}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.slashing'}}"/>
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.slashing" {{#if item.system.weapon.dmgTypes.slashing}}checked{{/if}} />
                </label>

                <label class="type-toggle" data-tooltip="{{tooltip 'type.piercing'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/piercing.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.piercing}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.piercing'}}"/>
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.piercing" {{#if item.system.weapon.dmgTypes.piercing}}checked{{/if}} />
                </label>

                <label class="type-toggle" data-tooltip="{{tooltip 'type.crushing'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/crushing.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.crushing}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.crushing'}}"/>
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.crushing" {{#if item.system.weapon.dmgTypes.crushing}}checked{{/if}} />
                </label>
                <label class="type-toggle" data-tooltip="{{tooltip 'type.missile'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/missile.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.missile}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.missile'}}"/>
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.missile" {{#if item.system.weapon.dmgTypes.missile}}checked{{/if}} />
                </label>
                <label class="type-toggle" data-tooltip="{{tooltip 'type.fire'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/fire.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.fire}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.fire'}}" />
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.fire" {{#if item.system.weapon.dmgTypes.fire}}checked{{/if}} />
                </label>

                <label class="type-toggle" data-tooltip="{{tooltip 'type.ice'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/ice.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.ice}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.ice'}}" />
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.ice" {{#if item.system.weapon.dmgTypes.ice}}checked{{/if}} />
                </label>

                <label class="type-toggle" data-tooltip="{{tooltip 'type.lightning'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/lightning.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.lightning}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.lightning'}}" />
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.lightning" {{#if item.system.weapon.dmgTypes.lightning}}checked{{/if}} />
                </label>
                <label class="type-toggle" data-tooltip="{{tooltip 'type.wind'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/wind.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.wind}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.wind'}}" />
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.wind" {{#if item.system.weapon.dmgTypes.wind}}checked{{/if}} />
                </label>

                <label class="type-toggle" data-tooltip="{{tooltip 'type.arcane'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/arcane.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.arcane}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.arcane'}}" />
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.arcane" {{#if item.system.weapon.dmgTypes.arcane}}checked{{/if}} />
                </label>

                <label class="type-toggle" data-tooltip="{{tooltip 'type.decay'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/decay.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.decay}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.decay'}}"/>
                <input class="hidden-checkbox" type="checkbox" name="system.weapon.dmgTypes.decay" {{#if item.system.weapon.dmgTypes.decay}}checked{{/if}} />
                </label>
                <label class="type-toggle" data-tooltip="{{tooltip 'type.shadow'}}">
                <img src="systems/emblem-rpg/assets/ui/dmg-types/shadow.png"
                    style="opacity: {{#if item.system.weapon.dmgTypes.shadow}}1{{else}}0.2{{/if}};"
                    data-tooltip="{{tooltip 'type.shadow'}}" />
