                   style="opacity: {{#if item.system.weapon.effectiveAgainst.undead}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.undead'}}"/>
              <input type="checkbox" name="system.weapon.effectiveAgainst.undead" {{#if item.system.weapon.effectiveAgainst.undead}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.monster'}}">
              <img src="systems/emblem-rpg/assets/ui/unit-types/monster-type.png"
                   style="opacity: {{#if item.system.weapon.effectiveAgainst.monster}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.monster'}}"/>
              <input type="checkbox" name="system.weapon.effectiveAgainst.monster" {{#if item.system.weapon.effectiveAgainst.monster}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.magic'}}">
              <img src="systems/emblem-rpg/assets/ui/unit-types/magic-type.png"
                   style="opacity: {{#if item.system.weapon.effectiveAgainst.magic}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.magic'}}"/>
              <input type="checkbox" name="system.weapon.effectiveAgainst.magic" {{#if item.system.weapon.effectiveAgainst.magic}}checked{{/if}} />
            </label>
          </div>
        </div>


        <div class="effects-box weapon-advantage-section">
          <label class="effects-box-label">Weapon Breaker(s)</label>
          <div class="breaker-icons">
            <label class="unit-toggle" data-tooltip="{{tooltip 'type.blade'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-blade.png"
                   style="opacity: {{#if item.system.weapon.breaker.blade}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.blade'}}"/>
              <input type="checkbox" name="system.weapon.breaker.blade" {{#if item.system.weapon.breaker.blade}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.polearm'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-polearm.png"
                   style="opacity: {{#if item.system.weapon.breaker.polearm}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.polearm'}}"/>
              <input type="checkbox" name="system.weapon.breaker.polearm" {{#if item.system.weapon.breaker.polearm}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.brawling'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-brawling.png"
                   style="opacity: {{#if item.system.weapon.breaker.brawling}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.brawling'}}"/>
              <input type="checkbox" name="system.weapon.breaker.brawling" {{#if item.system.weapon.breaker.brawling}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.heavy'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-heavy.png"
                   style="opacity: {{#if item.system.weapon.breaker.heavy}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.heavy'}}"/>
              <input type="checkbox" name="system.weapon.breaker.heavy" {{#if item.system.weapon.breaker.heavy}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.bow'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-bow.png"
                   style="opacity: {{#if item.system.weapon.breaker.bow}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.bow'}}"/>
              <input type="checkbox" name="system.weapon.breaker.bow" {{#if item.system.weapon.breaker.bow}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.covert'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-covert.png"
                   style="opacity: {{#if item.system.weapon.breaker.covert}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.covert'}}"/>
              <input type="checkbox" name="system.weapon.breaker.covert" {{#if item.system.weapon.breaker.covert}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.elemental'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-element.png"
                   style="opacity: {{#if item.system.weapon.breaker.elemental}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.elemental'}}"/>
              <input type="checkbox" name="system.weapon.breaker.elemental" {{#if item.system.weapon.breaker.elemental}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.divine'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-divine.png"
                   style="opacity: {{#if item.system.weapon.breaker.divine}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.divine'}}"/>
              <input type="checkbox" name="system.weapon.breaker.divine" {{#if item.system.weapon.breaker.divine}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.occult'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-occult.png"
                   style="opacity: {{#if item.system.weapon.breaker.occult}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.occult'}}"/>
              <input type="checkbox" name="system.weapon.breaker.occult" {{#if item.system.weapon.breaker.occult}}checked{{/if}} />
            </label>

            <label class="unit-toggle" data-tooltip="{{tooltip 'type.arcane'}}">
              <img src="systems/emblem-rpg/assets/ui/proficiencies/prof-arcane.png"
                   style="opacity: {{#if item.system.weapon.breaker.arcane}}1.0{{else}}0.2{{/if}};"
                   data-tooltip="{{tooltip 'type.arcane'}}"/>
              <input type="checkbox" name="system.weapon.breaker.arcane" {{#if item.system.weapon.breaker.arcane}}checked{{/if}} />
            </label>
          </div>
        </div>

        <div class="effects-box extra-attacks-section">
          <label class="effects-box-label">Extra Attacks</label>
          <input class="extra-attacks-bonus-input {{#if item.system.weapon.noExtraAttacks}}is-disabled{{/if}}" type="number" name="system.weapon.extraAttacks" value="{{item.system.weapon.extraAttacks}}" min="0" step="1" {{#if item.system.weapon.noExtraAttacks}}disabled{{/if}} />
          <label class="extra-attacks-disable" data-tooltip="{{tooltip 'item.click-toggle-grey-off-red-on'}}">
            <span class="toggle-text">Disabled</span>
            <input class="no-extra-attacks-checkbox" type="checkbox" name="system.weapon.noExtraAttacks" {{#if item.system.weapon.noExtraAttacks}}checked{{/if}} />
          </label>
        </div>

        {{!-- Effective Types spans both grid rows, and Add Effect sits under the Weapon Breaker and Extra Attacks
          boxes. --}}
        <div class="effects-row-hit-effect">
          <button type="button" class="add-effect-btn">
            <i class="fas fa-plus"></i> Add Effect
          </button>
        </div>

        </div>

        {{!-- _wireEffects in ui/apps/sheets/item/sheet.mjs makes these rows drag-reorderable and saves the new
          order to system.effects. --}}
        <div class="effects-entries">
          {{#each item.system.effects as |entry idx|}}
          <div class="effects-entry" data-effect-index="{{idx}}" draggable="true">
            <span class="eff-row-drag" data-tooltip="{{tooltip 'item.drag-to-reorder'}}"><i class="fas fa-grip-vertical"></i></span>
            <span class="eff-row-pill eff-row-pill-{{entry.trigger}}">{{triggerLabel entry.trigger}}</span>
            <input type="text" class="eff-row-name" data-effect-index="{{idx}}" value="{{entry.name}}" placeholder="Effect name" />
            <span class="eff-row-summary" data-tooltip="{{entry.action.steps.length}} step(s)">{{entry.action.steps.length}} step{{#unless (eq entry.action.steps.length 1)}}s{{/unless}}</span>
            <button type="button" class="eff-row-btn eff-row-edit" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'item.edit'}}"><i class="fas fa-pen"></i></button>
            <button type="button" class="eff-row-btn eff-row-delete" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'item.delete'}}"><i class="fas fa-trash"></i></button>
          </div>
          {{/each}}
        </div>

        {{/if}}

        {{#if typeFlags.isPassive}}

        <div class="eff-groupb-header">
          <button type="button" class="eff-groupb-btn add-effect-btn">
            <i class="fas fa-plus"></i> Add Effect
          </button>
        </div>

        <div class="effects-entries">
          {{#each item.system.effects as |entry idx|}}
          <div class="effects-entry" data-effect-index="{{idx}}" draggable="true">
            <span class="eff-row-drag" data-tooltip="{{tooltip 'item.drag-to-reorder'}}"><i class="fas fa-grip-vertical"></i></span>
            <span class="eff-row-pill eff-row-pill-{{entry.trigger}}">{{triggerLabel entry.trigger}}</span>
            <input type="text" class="eff-row-name" data-effect-index="{{idx}}" value="{{entry.name}}" placeholder="Effect name" />
            <span class="eff-row-summary" data-tooltip="{{entry.action.steps.length}} step(s)">{{entry.action.steps.length}} step{{#unless (eq entry.action.steps.length 1)}}s{{/unless}}</span>
            <button type="button" class="eff-row-btn eff-row-edit" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'item.edit'}}"><i class="fas fa-pen"></i></button>
            <button type="button" class="eff-row-btn eff-row-delete" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'item.delete'}}"><i class="fas fa-trash"></i></button>
          </div>
          {{/each}}
        </div>

        {{/if}}

        {{#if typeFlags.isActivatedItem}}

        <div class="eff-groupb-header">
          <button type="button" class="eff-groupb-btn add-effect-btn">
            <i class="fas fa-plus"></i> Add Effect
          </button>
          <button type="button" class="eff-groupb-btn open-params-btn">
            {{#if hasParams}}
              <i class="fas fa-square-check"></i> Edit Params
            {{else}}
              <i class="fas fa-square"></i> Add Params
            {{/if}}
          </button>
        </div>

        <div class="effects-entries">
          {{#each item.system.effects as |entry idx|}}
          <div class="effects-entry" data-effect-index="{{idx}}" draggable="true">
            <span class="eff-row-drag" data-tooltip="{{tooltip 'item.drag-to-reorder'}}"><i class="fas fa-grip-vertical"></i></span>
            <span class="eff-row-pill eff-row-pill-{{entry.trigger}}">{{triggerLabel entry.trigger}}</span>
            <input type="text" class="eff-row-name" data-effect-index="{{idx}}" value="{{entry.name}}" placeholder="Effect name" />
            <span class="eff-row-summary" data-tooltip="{{entry.action.steps.length}} step(s)">{{entry.action.steps.length}} step{{#unless (eq entry.action.steps.length 1)}}s{{/unless}}</span>
            <button type="button" class="eff-row-btn eff-row-edit" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'item.edit'}}"><i class="fas fa-pen"></i></button>
            <button type="button" class="eff-row-btn eff-row-delete" data-effect-index="{{idx}}" data-tooltip="{{tooltip 'item.delete'}}"><i class="fas fa-trash"></i></button>
          </div>
          {{/each}}
        </div>

        {{/if}}

      </div>
      {{#unless typeFlags.isBooster}}
      <div class="tab-pane {{#if (eq activeTab "modifiers")}}active{{/if}}" data-tab-content="modifiers"{{#unless (eq activeTab "modifiers")}} style="display: none;"{{/unless}}>

        <div class="modifiers-header-row">
          <button type="button" class="add-modifier{{#if item.system.aura.enabled}} add-modifier--with-aura{{/if}}">
            <i class="fas fa-plus"></i> Add Modifier
          </button>
          <div class="aura-toggle-group" data-tooltip="{{tooltip 'item.emit-an-aura-with-the-aura-modifiers-below'}}">
            <label class="aura-toggle-label">
              <span>Enable Aura</span>
              <input type="checkbox" class="aura-enabled-checkbox" name="system.aura.enabled" {{#if item.system.aura.enabled}}checked{{/if}} />
            </label>
            <label class="aura-rng-label">
              <span>Rng</span>
              <input type="number" class="aura-rng-input" name="system.aura.rng"
                     value="{{item.system.aura.rng}}" min="0" max="5"
                     {{#unless item.system.aura.enabled}}disabled{{/unless}} />
            </label>
          </div>
        </div>


        <div class="modifier-entries">
          {{#each item.system.modifiers as |modifier i|}}
            <div class="modifier-entry{{#if (eq modifier.kind "aura")}} modifier-entry--aura{{/if}}" draggable="true" data-modifier-index="{{i}}">

              {{!-- compileCharacterData applies modifiers in row order, unconditional ones before gated ones. --}}
              <span class="modifier-drag-handle" data-tooltip="{{tooltip 'item.drag-to-reorder-top-applied-first'}}">
                <i class="fas fa-grip-vertical"></i>
              </span>

              {{#if (eq modifier.kind "aura")}}
              {{!-- The badge marks an aura modifier. The saved kind comes from the hidden kind input below. --}}
              <span class="modifier-aura-badge" data-tooltip="{{tooltip 'item.aura-modifier-applies-to-actors-in-range-by-target-type'}}">
                <i class="fas fa-broadcast-tower"></i>
              </span>
              {{/if}}


              <input type="text" name="system.modifiers.{{i}}.name"
                    value="{{modifier.name}}"
                    placeholder="Name" />

              {{!-- The sheet submits the whole form on every change, and the submitted modifiers replace the saved
                list. These hidden inputs carry the fields the modifier dialog edits, so each submit keeps them. --}}
              <input type="hidden" name="system.modifiers.{{i}}.target" value="{{modifier.target}}" />
              <input type="hidden" name="system.modifiers.{{i}}.quantity" value="{{modifier.quantity}}" />
              <input type="hidden" name="system.modifiers.{{i}}.condition" value="{{modifier.condition}}" />
              <input type="hidden" name="system.modifiers.{{i}}.requiresEquipped" value="{{modifier.requiresEquipped}}" />
              <input type="hidden" name="system.modifiers.{{i}}.requiresActivation" value="{{modifier.requiresActivation}}" />
              <input type="hidden" name="system.modifiers.{{i}}.stackable" value="{{modifier.stackable}}" />
              <input type="hidden" name="system.modifiers.{{i}}.kind" value="{{modifier.kind}}" />
              <input type="hidden" name="system.modifiers.{{i}}.targetType" value="{{modifier.targetType}}" />


              <button type="button" class="edit-modifier" data-index="{{i}}" data-tooltip="{{tooltip 'item.edit'}}">
                <i class="fas fa-pen"></i>
              </button>


              <button type="button" class="delete-modifier" data-index="{{i}}" data-tooltip="{{tooltip 'item.delete'}}">
                <i class="fas fa-trash"></i>
              </button>
            </div>
          {{/each}}

          {{#unless item.system.modifiers.length}}
            <div class="no-entries-msg">
              No modifiers defined. Click "Add Modifier" to create one.
            </div>
          {{/unless}}
        </div>
      </div>
      {{/unless}}
      {{#if typeFlags.showRequirementsTab}}
      <div class="tab-pane {{#if (eq activeTab "requirements")}}active{{/if}}" data-tab-content="requirements"{{#unless (eq activeTab "requirements")}} style="display: none;"{{/unless}}>
        {{!-- _wireRequirements in ui/apps/sheets/item/sheet.mjs wires the Add, Edit and Delete controls below. --}}
        <div class="requirements-header-row">
          <button type="button" class="add-requirement-btn">
            <i class="fas fa-plus"></i> Add Activation Requirement
          </button>
        </div>

        <div class="requirement-entries">
          {{#each item.system.requirements as |entry idx|}}
          <div class="requirement-entry" data-requirement-index="{{idx}}" draggable="true">
            <span class="req-row-drag" data-tooltip="{{tooltip 'item.drag-to-reorder'}}"><i class="fas fa-grip-vertical"></i></span>
            <span class="req-row-pill req-row-pill-{{entry.type}}">{{#if (eq entry.type 'terrainGeometry')}}Placement{{else}}Condition{{/if}}</span>
            <input type="text" class="req-row-name" data-requirement-index="{{idx}}" value="{{entry.name}}" placeholder="Requirement name" />
            <button type="button" class="req-row-btn req-row-edit" data-requirement-index="{{idx}}" data-tooltip="{{tooltip 'item.edit'}}"><i class="fas fa-pen"></i></button>
            <button type="button" class="req-row-btn req-row-delete" data-requirement-index="{{idx}}" data-tooltip="{{tooltip 'item.delete'}}"><i class="fas fa-trash"></i></button>
          </div>
          {{/each}}

          {{#unless item.system.requirements.length}}
          <div class="no-entries-msg">
            No activation requirements defined. Click "Add Activation Requirement" to create one.
          </div>
          {{/unless}}
        </div>
      </div>
      {{/if}}
    </div>
  </section>

    {{#if owner}}
  <div class="item-owner-badge {{#if owner.isNpc}}is-npc-owner{{/if}}" data-tooltip="{{owner.tooltip}}">
      {{#if showOwnerStealControls}}
        <label class="item-owner-flag-label">Flag:</label>
        <select class="item-owner-flag" name="system.stealable.flag">
          <option value="None"      {{#if (eq owner.stealableFlag "None")}}selected{{/if}}>None</option>
          <option value="Drops"     {{#if (eq owner.stealableFlag "Drops")}}selected{{/if}}>Drops</option>
          <option value="Stealable" {{#if (eq owner.stealableFlag "Stealable")}}selected{{/if}}>Stealable</option>
        </select>
        {{#unless (eq owner.stealableFlag "None")}}
          <label class="item-owner-dc-label">DC:</label>
          <input class="item-owner-dc" type="number" name="system.stealable.dc" value="{{owner.stealableDC}}" min="0" />
        {{/unless}}
        <span class="item-owner-label">Owner:</span>
      {{else}}
        <span class="item-owner-label">Owner:</span>
        <span class="item-owner-name">{{owner.name}}</span>
      {{/if}}
      <img class="item-owner-img" src="{{owner.img}}" alt="{{owner.name}}" style="{{avatarScale owner clip=true}}" />
    </div>
    {{/if}}

    {{#if typeFlags.showValue}}
    {{#unless hideValueField}}

    <div class="cost-tracker{{#if tradeDisabled}} trade-disabled{{/if}}">

      {{#if typeFlags.isCoinpurse}}
      <label>Total</label>
      {{else}}
      <label class="trade-toggle" data-action="toggleTradeDisabled"
             data-tooltip="{{#if tradeDisabled}}Not tradeable{{else}}Mark untradeable{{/if}}">
        Value
      </label>
      {{/if}}


      <div class="cost-input-row">
        <input type="number" name="system.cost" value="{{item.system.cost}}" max="99999" min="0" />
        <span>GP</span>
      </div>
    </div>
    {{/unless}}
    {{/if}}
</form>
